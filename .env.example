# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file (see .gitignore).

# --- Database ---
POSTGRES_USER=support_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=support_agent
DATABASE_URL=postgresql://support_admin:change_me@localhost:5432/support_agent
# ^ "localhost" is correct here for running scripts on your own machine.
# docker-compose.yml overrides this to use "postgres" automatically for
# the backend container -- you don't need to change this yourself.

# --- Groq LLM ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Confidence threshold (0.0 - 1.0), tune during Day 11 / Day 14 testing ---
CONFIDENCE_AUTO_RESOLVE_THRESHOLD=0.75

# --- Dashboard auth ---
DASHBOARD_PASSWORD=change_me
