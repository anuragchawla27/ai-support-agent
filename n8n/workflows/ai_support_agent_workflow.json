{
  "name": "AI Support Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support-query",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook - Customer Query",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-200, 300],
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "webhookId": "support-query-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/tickets/create",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"query_text\": $json.body.query_text, \"customer_name\": $json.body.customer_name, \"customer_email\": $json.body.customer_email } }}",
        "options": {}
      },
      "name": "Create Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 300],
      "id": "a1b2c3d4-0002-4000-8000-000000000002"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8000/tickets/{{ $json.ticket_id }}/respond",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": {}
      },
      "name": "Get AI Response",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 300],
      "id": "a1b2c3d4-0003-4000-8000-000000000003"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "Escalated",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Was It Escalated?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [520, 300],
      "id": "a1b2c3d4-0004-4000-8000-000000000004"
    },
    {
      "parameters": {
        "fromEmail": "notifications@pranavxlabs.example",
        "toEmail": "={{ $json.assigned_team === \"Sales\" ? \"sales@pranavxlabs.example\" : $json.assigned_team === \"Engineering\" ? \"support@pranavxlabs.example\" : $json.assigned_team === \"Internship Coordination\" ? \"internships@pranavxlabs.example\" : \"hello@pranavxlabs.example\" }}",
        "subject": "=Ticket Escalated: {{ $json.assigned_team }} ({{ $json.ticket_id }})",
        "emailFormat": "text",
        "text": "=A ticket needs human review.\n\nTicket ID: {{ $json.ticket_id }}\nAssigned team: {{ $json.assigned_team }}\nConfidence score: {{ $json.confidence_score }}\nFlagged for security review: {{ $json.flagged_for_review }}\n\nAI's attempted response:\n{{ $json.response }}\n\nReview this ticket in the dashboard.",
        "options": {}
      },
      "name": "Notify Team",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [760, 200],
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_YOUR_SMTP_CREDENTIAL_ID",
          "name": "SMTP account"
        }
      },
      "notes": "Configure SMTP credentials in n8n (Credentials > Add > SMTP) before using this node. See docs/n8n-workflow-setup.md."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"message\": \"Your question needs a closer look from our specialist team, and we will follow up with you directly.\", \"ticket_id\": $json.ticket_id, \"status\": $json.status } }}",
        "options": {}
      },
      "name": "Respond - Escalated",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1000, 200],
      "id": "a1b2c3d4-0006-4000-8000-000000000006"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"message\": $json.response, \"ticket_id\": $json.ticket_id, \"status\": $json.status } }}",
        "options": {}
      },
      "name": "Respond - Resolved",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [760, 420],
      "id": "a1b2c3d4-0007-4000-8000-000000000007"
    }
  ],
  "connections": {
    "Webhook - Customer Query": {
      "main": [
        [
          { "node": "Create Ticket", "type": "main", "index": 0 }
        ]
      ]
    },
    "Create Ticket": {
      "main": [
        [
          { "node": "Get AI Response", "type": "main", "index": 0 }
        ]
      ]
    },
    "Get AI Response": {
      "main": [
        [
          { "node": "Was It Escalated?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Was It Escalated?": {
      "main": [
        [
          { "node": "Notify Team", "type": "main", "index": 0 }
        ],
        [
          { "node": "Respond - Resolved", "type": "main", "index": 0 }
        ]
      ]
    },
    "Notify Team": {
      "main": [
        [
          { "node": "Respond - Escalated", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "instanceId": "pranavx-ai-support-agent"
  }
}
